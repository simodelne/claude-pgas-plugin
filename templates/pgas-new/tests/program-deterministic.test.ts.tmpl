import { describe, expect, it } from 'vitest';
import {
  createToolRegistry,
  loadProgramByConvention,
  type ProgramAdapterOverride,
  type ProgramEntry,
  type Specification,
  type ToolHandler,
} from '@simodelne/pgas-server/plugin.js';
import { createTestHarness, type TestHarnessAuthorResponse } from '@simodelne/pgas-server/testing.js';
import { createHandlerAdapterOverrides, handlers, reactionHandlers } from '../src/programs/{{SLUG}}/handlers.js';
import { registeredToolNames, register{{PASCAL_NAME}}Tools } from '../src/programs/{{SLUG}}/tools.js';

const programsRoot = decodeURIComponent(new URL('../src', import.meta.url).pathname);

function create{{PASCAL_NAME}}ProgramEntry(): ProgramEntry {
  const toolRegistry = createToolRegistry();
  register{{PASCAL_NAME}}Tools(toolRegistry);
  const loaded = loadProgramByConvention('{{SLUG}}', {
    programsRoot,
    additionalHandlers: {
      ...handlers,
      ...toolHandlerPlaceholders(toolRegistry),
    },
    reactionHandlers,
    adapterOptions: {
      overrides: {
        ...createHandlerAdapterOverrides(),
        ...toolAdapterOverrides(toolRegistry),
      },
    },
  });
  return { ...loaded.entry, spec: withDecisionOnlyRegistryPrompts(loaded.entry.spec) };
}

function toolHandlerPlaceholders(toolRegistry: ReturnType<typeof createToolRegistry>): Record<string, ToolHandler> {
  const placeholders: Record<string, ToolHandler> = {};
  for (const name of registeredToolNames) {
    if (!toolRegistry.has(name)) continue;
    placeholders[`invoke_tool_${name}`] = async () => {
      throw new Error(`tool adapter for ${name} was not installed`);
    };
  }
  return placeholders;
}

function toolAdapterOverrides(toolRegistry: ReturnType<typeof createToolRegistry>): Record<string, ProgramAdapterOverride> {
  const overrides: Record<string, ProgramAdapterOverride> = {};
  for (const name of registeredToolNames) {
    if (toolRegistry.has(name)) {
      overrides[`tool:${name}`] = toolRegistry.createAdapter(name);
    }
  }
  return overrides;
}

function withDecisionOnlyRegistryPrompts<T extends {
  modes?: Map<string, { decisionOnly?: boolean }>;
  prompts?: Map<string, string>;
}>(spec: T): T {
  if (!(spec.modes instanceof Map) || !(spec.prompts instanceof Map)) {
    return spec;
  }
  const prompts = new Map(spec.prompts);
  for (const [modeName, mode] of spec.modes) {
    if (mode.decisionOnly === true && !prompts.has(modeName)) {
      prompts.set(modeName, 'Decision-only auto-transition mode.');
    }
  }
  const descriptors = Object.getOwnPropertyDescriptors(spec);
  delete descriptors.prompts;
  const clone = Object.create(Object.getPrototypeOf(spec)) as T;
  Object.defineProperties(clone, descriptors);
  Object.defineProperty(clone, 'prompts', {
    value: prompts,
    enumerable: true,
    configurable: true,
  });
  return clone;
}

interface DeterministicStep {
  name: string;
  channel: string;
  trigger: string;
}

interface DeterministicMode {
  decision_only?: boolean;
  vocabulary: readonly string[];
  transitions: ReadonlyArray<{ target: string; when?: unknown }>;
  preconditions?: Map<string, readonly unknown[]> | { readonly [actionName: string]: readonly unknown[] | undefined };
}

const CONTROL_ACTIONS = new Set([
  'record_note',
  'pin_note',
  'unpin_note',
  'delete_note',
  'session_new',
  'session_abort_current',
  'session_status',
  'session_history',
  'session_resume',
  'session_help',
]);

describe('{{SLUG}} deterministic runtime', () => {
  it('drives the program through a deterministic trigger path', async () => {
    const entry = create{{PASCAL_NAME}}ProgramEntry();
    const steps = buildDeterministicPath(entry);
    const harness = await createTestHarness(entry, {
      programName: '{{SLUG}}',
      defaultChannel: firstInputChannel(entry.spec),
      authorResponses: steps.map((step) => effect(step)),
    });

    try {
      const snapshot = await harness.runToTerminal(
        steps.map((step) => step.trigger),
        { maxTriggers: steps.length + 2 },
      );

      expect(snapshot.terminal).toBe(true);
      expect(entry.spec.terminal).toContain(snapshot.mode);
      expect(snapshot.rounds.length).toBeGreaterThanOrEqual(steps.length);
      expect(hasFallbackRound(snapshot.rounds)).toBe(false);
    } finally {
      await harness.close();
    }
  });
});

function buildDeterministicPath(entry: ProgramEntry): DeterministicStep[] {
  const spec = entry.spec;
  const terminalModes = new Set(spec.terminal);
  const steps: DeterministicStep[] = [];
  const visited = new Set<string>();
  let modeName = spec.initial;

  while (!terminalModes.has(modeName)) {
    if (visited.has(modeName)) {
      throw new Error(`deterministic path cycle before terminal mode: ${modeName}`);
    }
    visited.add(modeName);

    const mode = spec.modes.get(modeName);
    if (!mode) {
      throw new Error(`missing mode in deterministic path: ${modeName}`);
    }

    const automaticTarget = automaticDecisionOnlyTarget(mode);
    if (automaticTarget) {
      modeName = automaticTarget;
      continue;
    }

    const next = nextTransitionAction(spec, modeName);
    steps.push({
      name: next.name,
      channel: spec.action_map.get(next.name)?.channel ?? 'widget_output',
      trigger: steps.length === 0 ? 'start deterministic scaffold' : 'continue deterministic scaffold',
    });
    modeName = next.target;
  }

  if (steps.length === 0) {
    throw new Error('deterministic path is already terminal at session start');
  }
  return steps;
}

function nextTransitionAction(spec: Specification, modeName: string): { name: string; target: string } {
  const mode = spec.modes.get(modeName);
  if (!mode) {
    throw new Error(`missing mode in deterministic path: ${modeName}`);
  }

  const transitionTargets = new Set(mode.transitions.map((transition) => transition.target));
  const candidates = [...(spec.proceeds_to?.entries() ?? [])]
    .filter(([name, target]) => transitionTargets.has(target) && mode.vocabulary.includes(name))
    .filter(([name]) => canDriveActionLinearly(mode, name))
    .filter(([name]) => !CONTROL_ACTIONS.has(name));

  const candidate = candidates[0];
  if (!candidate) {
    throw new Error(`no deterministic transition action from mode: ${modeName}`);
  }
  return { name: candidate[0], target: candidate[1] };
}

function automaticDecisionOnlyTarget(mode: DeterministicMode): string | undefined {
  if (mode.decision_only !== true || mode.vocabulary.length > 0 || mode.transitions.length !== 1) {
    return undefined;
  }
  const transition = mode.transitions[0];
  if (!transition || transition.when !== undefined) {
    return undefined;
  }
  return transition.target;
}

function canDriveActionLinearly(mode: DeterministicMode, actionName: string): boolean {
  return !preconditionsFor(mode, actionName).some((precondition) => {
    if (!precondition || typeof precondition !== 'object' || Array.isArray(precondition)) {
      return false;
    }
    const path = (precondition as { path?: unknown }).path;
    return typeof path === 'string' && path.endsWith('.fan_out.complete');
  });
}

function preconditionsFor(mode: DeterministicMode, actionName: string): readonly unknown[] {
  const preconditions = mode.preconditions;
  if (!preconditions) {
    return [];
  }
  if (preconditions instanceof Map) {
    return preconditions.get(actionName) ?? [];
  }
  return preconditions[actionName] ?? [];
}

function firstInputChannel(spec: Specification): string {
  let fallback: string | undefined;
  for (const [id, channel] of spec.schannels) {
    if (channel.direction !== 'In') {
      continue;
    }
    fallback ??= id;
    if (id !== 'seed' && id !== 'system_mode_entry') {
      return id;
    }
  }
  if (fallback) {
    return fallback;
  }
  throw new Error(`program ${spec.name} declares no input channel`);
}

function effect(step: DeterministicStep): TestHarnessAuthorResponse {
  return {
    actions: [{
      kind: 'EffectAction',
      name: step.name,
      channel: step.channel,
      payload: payloadFor(step),
    }],
  };
}

function payloadFor(step: DeterministicStep): Record<string, unknown> {
  const payload: Record<string, unknown> = {
    result_json: JSON.stringify({ stage: step.name, status: 'deterministic' }),
    items_json: JSON.stringify([step.name]),
  };
  if (step.channel === 'stage_output') {
    payload.__stage_runtime = {
      now_iso: '2026-06-28T00:00:00.000Z',
      random: 0.25,
    };
  }
  return payload;
}

function hasFallbackRound(rounds: unknown[]): boolean {
  return rounds.some((round) => {
    if (!round || typeof round !== 'object' || Array.isArray(round)) return false;
    const result = (round as { result?: unknown }).result;
    return !!result && typeof result === 'object' && !Array.isArray(result) &&
      (result as { fallback?: unknown }).fallback === true;
  });
}
