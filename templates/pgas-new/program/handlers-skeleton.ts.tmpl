import type { ReactionHandler, ToolHandler } from '@simodelne/pgas-server/plugin.js';

// The synthesizer emits this template as a handler directory:
// - handlers/index.ts
// - handlers/_resolver.ts

export const handlers: Record<string, ToolHandler> = {
  async begin_work(payload) {
    return {
      kind: 'work_started',
      payload,
    };
  },

  async record_note(payload) {
    return {
      kind: 'note_recorded',
      payload,
    };
  },

  async pin_note(payload) {
    return {
      kind: 'note_pinned',
      payload,
    };
  },

  async unpin_note(payload) {
    return {
      kind: 'note_unpinned',
      payload,
    };
  },

  async delete_note(payload) {
    return {
      kind: 'note_deleted',
      payload,
    };
  },

  async example_action(payload) {
    return {
      kind: 'example_completed',
      payload,
    };
  },
};

// The generated scaffold has no foundry-driven reactions by default. Consumer
// programs can add reactions by populating this map.
export const reactionHandlers: Map<string, ReactionHandler> = new Map();
